{
  "name": "@phronon/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Accessibility-first Phronon desktop app for blind and low-vision students.",
  "author": "Phronon contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "renderer:dev": "vite",
    "electron:dev": "tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "release:win": "npm run build && electron-builder --win dir",
    "release:win:installer": "npm run build && electron-builder --win nsis --config.directories.output=../../release-installer",
    "release:win:all": "npm run release:win && npm run release:win:installer",
    "start": "electron dist-electron/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "tsc -p tsconfig.tests.json && node test-dist/readerControls.test.js && node test-dist/documentWorkflow.test.js && node test-dist/runtimeDiagnostics.test.js && node test-dist/speechVoices.test.js && node test-dist/voiceCommands.test.js"
  },
  "dependencies": {
    "pdfjs-dist": "^5.5.207",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "org.phronon.desktop",
    "productName": "Phronon",
    "electronVersion": "38.1.2",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../backend/src",
        "to": "backend/src"
      },
      {
        "from": "public/icons/phronon.ico",
        "to": "assets/phronon.ico"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false,
      "icon": "public/icons/phronon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Phronon"
    }
  }
}
